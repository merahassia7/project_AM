<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- This will hold the first part of the description (Specialties) -->
        <TextView
            android:id="@+id/tvSpecialties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="italic"
            android:textColor="#007BFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="12dp" />

        <!-- Requirements: Call, SMS, Email, Map -->
        <Button android:id="@+id/btnCall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Call" android:layout_marginTop="24dp" />
        <Button android:id="@+id/btnSMS" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SMS" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Maps" android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
